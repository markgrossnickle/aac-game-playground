{
  "name": "game-bundle-hub",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "smoke": "playwright test",
    "new-game": "node scripts/new-game.mjs",
    "local": "npm run build && node node_modules/aac-bridge/relay/server.js --serve dist"
  },
  "devDependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.6.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "aac-bridge": "github:markgrossnickle/aac-bridge#v0.4.0",
    "qrcode-generator": "1.4.4"
  }
}
