{
  "$schema": "./schemas/bundle.config.schema.json",
  "name": "AAC Game Playground",
  "shortName": "AAC Games",
  "description": "Small games you can play with an AAC board, by touch, or both.",
  "repository": "markgrossnickle/aac-game-playground",
  "appId": "com.markgrossnickle.aacgameplayground",
  "webUrl": "https://aac-game-playground.vercel.app",
  "apkUrl": "https://aac-game-playground-apk.vercel.app",
  "theme": {
    "background": "#0e1116",
    "accent": "#58a6ff"
  },
  "budgets": {
    "maxGameMB": 10,
    "maxFileMB": 3,
    "maxFilesPerGame": 400
  },
  "audio": {
    "defaultMutedOnDesktop": false
  },
  "aac": {
    "relay": null
  }
}
